{
  "name": "@idevs/corelib",
  "version": "1.1.1",
  "description": "Extended library components and utilities for Serenity Framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./globals": {
      "types": "./dist/globals/index.d.ts",
      "import": "./dist/globals/index.js",
      "require": "./dist/globals/index.js"
    },
    "./editors/idevsDateEditor": {
      "types": "./dist/editors/idevsDateEditor.d.ts",
      "import": "./dist/editors/idevsDateEditor.js",
      "require": "./dist/editors/idevsDateEditor.js"
    },
    "./grids/idevsSelectableEntityGrid": {
      "types": "./dist/grids/idevsSelectableEntityGrid.d.ts",
      "import": "./dist/grids/idevsSelectableEntityGrid.js",
      "require": "./dist/grids/idevsSelectableEntityGrid.js"
    },
    "./grids/idevsGridEditorBase": {
      "types": "./dist/grids/idevsGridEditorBase.d.ts",
      "import": "./dist/grids/idevsGridEditorBase.js",
      "require": "./dist/grids/idevsGridEditorBase.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && npm run build:css",
    "build:css": "cp -r css dist/",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "dev": "npm run build:watch",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"*.{md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"*.{md,json}\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "idevs",
    "idevswork",
    "corelib",
    "serenity"
  ],
  "author": "Sarawut Phaekuntod",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klomkling/idevs.corelib"
  },
  "peerDependencies": {
    "@serenity-is/corelib": ">=8.8.6 <9",
    "@serenity-is/extensions": ">=8.7 <11",
    "@serenity-is/sleekgrid": ">=1.9.6 <2",
    "flatpickr": ">=4.6 <5",
    "jquery": ">=3.5",
    "jspdf": ">=3"
  },
  "peerDependenciesMeta": {
    "@serenity-is/corelib": {
      "optional": false
    },
    "@serenity-is/sleekgrid": {
      "optional": false
    },
    "@serenity-is/extensions": {
      "optional": true
    },
    "flatpickr": {
      "optional": true
    },
    "jquery": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    }
  },
  "overrides": {
    "@serenity-is/tsbuild": {
      "glob": "11.1.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@serenity-is/corelib": "^8.8.6",
    "@serenity-is/sleekgrid": "^1.9.6",
    "@serenity-is/tsbuild": "^8.8.7",
    "@types/jquery": "^3.5.32",
    "@types/jquery.validation": "^1.17.0",
    "@types/jqueryui": "^1.12.24",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "flatpickr": "^4.6.13",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  }
}
